{
  "name": "priama",
  "version": "0.0.5",
  "description": "Local-first desktop writing application for authors",
  "main": "./out/main/index.js",
  "author": "priama",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE PRIAMA_DEV=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps || true",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && node scripts/buildMac.cjs",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/literata": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "docx": "^9.2.0",
    "epub-gen-memory": "^1.1.2",
    "epubjs": "^0.3.93",
    "fs-extra": "^11.3.0",
    "image-size": "^1.2.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.2",
    "nspell": "^2.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "yauzl": "^2.10.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.priama.app",
    "productName": "Priama",
    "afterPack": "scripts/afterPackAdhocSign.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "!.env*",
      "!.cursor/**/*",
      "!src/**/*",
      "!docs/**/*",
      "!**/*.tsbuildinfo",
      "!.git/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "tomes",
        "name": "Priama Project",
        "description": "Priama book project",
        "role": "Editor"
      }
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Priama Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "tomes"
            ],
            "LSItemContentTypes": [
              "com.priama.project"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "dmg": {
      "artifactName": "Priama-${version}-mac-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "andyrpr",
      "repo": "priama",
      "releaseType": "release"
    }
  }
}
